# SEC asks automated clients for a descriptive User-Agent with contact info (required for EDGAR)
SEC_USER_AGENT=my-radar you@example.com
# Push notifications via ntfy (pick a long random topic only you know)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Public URL of the dashboard, used for links inside notifications (optional)
RADAR_PUBLIC_URL=
# Claude features (daily/weekly reports, summaries, chat) — optional, needs the Claude Code CLI logged in
# CLAUDE_CMD=claude -p --output-format text --allowedTools WebSearch,WebFetch
